<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    tools:ignore="TooManyViews">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationContentDescription="@string/action_cancel"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="18dp"
                    android:layout_height="2dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/deck_accent" />

                <TextView
                    style="@style/TextAppearance.OpenBrowser.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_eyebrow" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/editor_hero_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeroDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/editor_hero_desc"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- 基础信息 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OpenBrowser.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View style="@style/Widget.OpenBrowser.SectionBar" />

                        <TextView
                            style="@style/Widget.OpenBrowser.SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_basic" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_name">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_group">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_start_url"
                        app:helperText="@string/start_url_helper">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStartUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Dropdown"
                        android:hint="@string/label_engine"
                        app:helperText="@string/engine_helper">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/engineInput"
                            style="@style/Widget.Material3.AutoCompleteTextView.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_note">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 设备与指纹 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OpenBrowser.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View style="@style/Widget.OpenBrowser.SectionBar" />

                        <TextView
                            style="@style/Widget.OpenBrowser.SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_device" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRandomFingerprint"
                            style="@style/Widget.OpenBrowser.Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/action_random_fingerprint"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Dropdown"
                        android:hint="@string/label_preset">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/presetInput"
                            style="@style/Widget.Material3.AutoCompleteTextView.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_user_agent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUserAgent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="4"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_platform">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPlatform"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/label_locale">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLocale"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="@string/label_timezone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTimezone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/label_screen_width">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etScreenWidth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="@string/label_screen_height">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etScreenHeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/label_dpr">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDpr"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="@string/label_cpu">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCpu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/label_memory">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMemory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="@string/label_touch">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTouch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swMobile"
                        style="@style/Widget.OpenBrowser.SwitchRow"
                        android:text="@string/label_mobile_mode" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_webgl_vendor">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWebglVendor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_webgl_renderer">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWebglRenderer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swCanvas"
                        style="@style/Widget.OpenBrowser.SwitchRow"
                        android:text="@string/label_canvas_noise" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAudio"
                        style="@style/Widget.OpenBrowser.SwitchRow"
                        android:text="@string/label_audio_noise" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Dropdown"
                        android:hint="@string/label_webrtc_mode">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/webrtcInput"
                            style="@style/Widget.Material3.AutoCompleteTextView.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_webrtc_ip">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWebRtcIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 网络与代理 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OpenBrowser.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View style="@style/Widget.OpenBrowser.SectionBar" />

                        <TextView
                            style="@style/Widget.OpenBrowser.SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_network" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Dropdown"
                        android:hint="@string/label_proxy_type">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/proxyTypeInput"
                            style="@style/Widget.Material3.AutoCompleteTextView.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_weight="2"
                            android:hint="@string/label_proxy_host">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etProxyHost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.OpenBrowser.Field"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="@string/label_proxy_port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etProxyPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_proxy_user">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProxyUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.OpenBrowser.Field"
                        android:hint="@string/label_proxy_password">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProxyPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestProxy"
                        style="@style/Widget.OpenBrowser.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/action_test_proxy" />

                    <TextView
                        android:id="@+id/tvProxyResult"
                        style="@style/Widget.OpenBrowser.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textIsSelectable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 环境数据 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OpenBrowser.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View style="@style/Widget.OpenBrowser.SectionBar" />

                        <TextView
                            style="@style/Widget.OpenBrowser.SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_data" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDataSize"
                        style="@style/Widget.OpenBrowser.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearData"
                        style="@style/Widget.OpenBrowser.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/action_clear_profile_data"
                        android:textColor="@color/deck_danger"
                        app:strokeColor="@color/deck_danger" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.OpenBrowser.Button.Primary.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:text="@string/action_save_env" />
    </LinearLayout>
</LinearLayout>
